{
  "expo": {
    "name": "Funny Words",
    "slug": "party-fun-2",
    "version": "1.0.0",
    "platforms": [
      "ios",
      "android",
      "web"
    ],
    "orientation": "default",
    "icon": "./assets/AppIcons/playstore.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/AppIcons/playstore.png",
      "resizeMode": "contain",
      "backgroundColor": "#005ab2"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "softwareKeyboardLayoutMode": "resize",
      "adaptiveIcon": {
        "foregroundImage": "./assets/AppIcons/playstore.png",
        "backgroundColor": "#005ab2"
      },
      "package": "com.arocafull.partyfun2"
    },
    "web": {
      "favicon": "./assets/AppIcons/playstore.png",
      "bundler": "metro"
    },
    "scheme": "partyfun",
    "plugins": [
      "expo-router",
      "expo-sqlite",
      "expo-font",
      "expo-audio"
    ]
  }
}
